{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fairshare",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fairshare-db",
      "database_id": "539b432e-b9ff-474a-99e0-d745af8e05e2",
      "migrations_dir": "db/migrations"
    }
  ],
  // Serve the app at the root of fairshare.page. Cloudflare creates the DNS record and certificate.
  "routes": [{ "pattern": "fairshare.page", "custom_domain": true }],
  "workers_dev": false,
  "vars": {
    // Local dev overrides these from .dev.vars.
    "APP_URL": "https://fairshare.page",
    "EMAIL_FROM": "FairShare <noreply@fairshare.page>"
  },
  "observability": { "enabled": true }
}
